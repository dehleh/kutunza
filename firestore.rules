rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Deny all by default ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────
    // Users can read/update their own profile only
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      // User's order subcollection
      match /orders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Orders ─────────────────────────────────────────────────
    // Only the backend (Admin SDK) should write orders
    // Users can only read their own orders
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── Menu (public read) ─────────────────────────────────────
    match /menu/{catId} {
      allow read: if true;
    }

    // ─── Events ─────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── Settings (public read) ─────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
    }

    // ─── Payments (admin only) ──────────────────────────────────
    match /payments/{paymentId} {
      allow read: if request.auth != null && isAdmin();
    }

    // ─── Admins collection (no client access) ───────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Rewards ─────────────────────────────────────────────────
    // Users can read their own rewards account
    match /rewards/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Transaction subcollection
      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Helper function ────────────────────────────────────────
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
