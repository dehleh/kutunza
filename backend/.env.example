# Kutunza Backend — Environment Variables
# Copy this file to .env and fill in real values

# ─── Firebase Admin SDK ───────────────────────────────────────
# Option A: Service account JSON file path
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Option B: Individual keys (for cloud hosting like Railway/Render)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Paystack (REQUIRED) ─────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App Config ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── Business Config ─────────────────────────────────────────
DELIVERY_FEE=1500
MIN_ORDER_AMOUNT=2000

# ─── Admin Bootstrap (B10 — TEMPORARY) ───────────────────────
# ⚠️  Set this to a random secret, then POST /api/auth/admin/bootstrap
# with { "secret": "your-secret" } while authenticated as the first admin user.
# IMPORTANT: Remove or unset ADMIN_BOOTSTRAP_SECRET after the first admin is created!
# Leaving this set is a security risk.
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-random-string
