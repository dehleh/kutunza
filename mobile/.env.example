# Kutunza Mobile — Environment Variables
# Copy this file to .env and fill in real values

# ─── Firebase (from Firebase Console → Project Settings → Web App) ─────
EXPO_PUBLIC_FB_API_KEY=AIzaSy...
EXPO_PUBLIC_FB_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FB_PROJECT_ID=your-project-id
EXPO_PUBLIC_FB_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FB_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FB_APP_ID=1:000000000000:web:abcdef1234567890

# ─── API ───────────────────────────────────────────────────────────────
# For physical device testing, use your computer's local IP (e.g., 192.168.1.x)
# For Android emulator, use 10.0.2.2
# For production, use your deployed backend URL
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# ─── Paystack ──────────────────────────────────────────────────────────
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
